{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moalborati/simon-part-6-recording-catalog/contracts/skeleton.v1.schema.json",
  "title": "skeleton.json, simon.skeleton.v1 (Part 4 input, Part 3 --view part4)",
  "description": "A skeleton as key poses: keyframes is a list of poses with joints, a time t in seconds (else index / 30) and an optional name. Part 6 recognizes it by the format field, which wins over a schema field, else by shape: keyframes[0] carries joints. local_rotations, bones and every other field are ignored.",
  "type": "object",
  "required": [
    "keyframes"
  ],
  "properties": {
    "format": {
      "const": "simon.skeleton.v1"
    },
    "keyframes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/pose"
      }
    }
  },
  "$defs": {
    "joint": {
      "description": "One joint: an object with x, y, z, or an array of three or more numbers (x, y, z first). Part 6 keeps x, y, z and ignores the rest.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          }
        },
        {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "number"
          }
        }
      ]
    },
    "jointMap": {
      "description": "All 17 canonical joints. Extra joints are ignored.",
      "type": "object",
      "required": [
        "nose",
        "left_eye",
        "right_eye",
        "left_ear",
        "right_ear",
        "left_shoulder",
        "right_shoulder",
        "left_elbow",
        "right_elbow",
        "left_wrist",
        "right_wrist",
        "left_hip",
        "right_hip",
        "left_knee",
        "right_knee",
        "left_ankle",
        "right_ankle"
      ],
      "properties": {
        "nose": {
          "$ref": "#/$defs/joint"
        },
        "left_eye": {
          "$ref": "#/$defs/joint"
        },
        "right_eye": {
          "$ref": "#/$defs/joint"
        },
        "left_ear": {
          "$ref": "#/$defs/joint"
        },
        "right_ear": {
          "$ref": "#/$defs/joint"
        },
        "left_shoulder": {
          "$ref": "#/$defs/joint"
        },
        "right_shoulder": {
          "$ref": "#/$defs/joint"
        },
        "left_elbow": {
          "$ref": "#/$defs/joint"
        },
        "right_elbow": {
          "$ref": "#/$defs/joint"
        },
        "left_wrist": {
          "$ref": "#/$defs/joint"
        },
        "right_wrist": {
          "$ref": "#/$defs/joint"
        },
        "left_hip": {
          "$ref": "#/$defs/joint"
        },
        "right_hip": {
          "$ref": "#/$defs/joint"
        },
        "left_knee": {
          "$ref": "#/$defs/joint"
        },
        "right_knee": {
          "$ref": "#/$defs/joint"
        },
        "left_ankle": {
          "$ref": "#/$defs/joint"
        },
        "right_ankle": {
          "$ref": "#/$defs/joint"
        }
      }
    },
    "person": {
      "type": "object",
      "required": [
        "joints"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "joints": {
          "$ref": "#/$defs/jointMap"
        }
      }
    },
    "pose": {
      "type": "object",
      "required": [
        "joints"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "joints": {
          "$ref": "#/$defs/jointMap"
        }
      },
      "anyOf": [
        {
          "required": [
            "t"
          ],
          "properties": {
            "t": {
              "type": "number"
            }
          }
        },
        {
          "required": [
            "index"
          ],
          "properties": {
            "index": {
              "type": "number"
            }
          }
        }
      ]
    }
  }
}
