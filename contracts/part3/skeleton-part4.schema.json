          "type": "string",
          "minLength": 1,
          "description": "simon-standard, part4-rig, measured, or file:<name from the profile file>."
        },
        "selected_by": {
          "enum": [
            "flag",
            "env",
            "config",
            "api",
            "default"
          ],
          "description": "Which channel chose the profile; default means none did, and the view's default was used (part4-rig for --view part4, simon-standard otherwise)."
        },
        "stature_selected_by": {
          "enum": [
            "flag",
            "env",
            "config",
            "api"
          ],
          "description": "Present when a stature was requested: which channel set it."
        },
        "stature_m": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2.5
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "symmetrized": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "Present only when the view chose the profile (selected_by default and --view part4): why that profile was used. A body named on any channel wins and has no reason."
        }
      },
      "required": [
        "profile",
        "selected_by",
        "stature_m",
        "scale",
        "source",
        "symmetrized"
      ],
      "description": "The body profile the output was rebuilt on."
    },
