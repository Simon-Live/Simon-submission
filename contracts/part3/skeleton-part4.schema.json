{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moalborati/simon-part-3-skeleton-consistency/contracts/skeleton-part4.schema.json",
  "title": "Part 3 skeleton.json (part4 view)",
  "description": "The output of python3 -m part3 run --view part4 --keyframes ...: the native skeleton plus the block Part 4 reads. Key joints are the forward kinematics of local_rotations on rest_offsets_m, so Part 4's 1 mm rule holds; rig.fit reports how far the snapped pose is from the native frame. Part 5 also reads this file as an expected skeleton (keyframes[] with joints as [x, y, z] lists). Rules a schema cannot say (checked by python3 -m part3 doctor <file> --for part4): key t equals index / 30 within one microsecond, indices strictly increase inside the clip, no quaternion has a norm under 1e-8, no joint turns more than 180 degrees between neighbouring keys in rotation-vector space (Part 3 refuses to write such a clip), forward kinematics reproduces each key within 1 mm, and keyframes.json sits beside this file with the same key indices.",
  "x-simon-version": "simon.skeleton.v1",
  "x-direction": "output",
  "x-producer": "Part 3",
  "x-consumers": [
    "Part 4",
    "Part 5"
  ],
  "x-version-field": "format",
  "type": "object",
  "required": [
    "schema",
    "units",
    "frame",
    "joints",
    "bones",
    "standard",
