          "$ref": "#/$defs/person_id"
        },
        "candidates": {
          "type": "object",
          "properties": {},
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "frames_present": {
          "type": "integer",
          "minimum": 0
        },
        "frames_dropped": {
          "type": "integer",
          "minimum": 0
        },
        "few_frames": {
          "type": "boolean"
        },
        "measured_bone_lengths_m": {
          "$ref": "#/$defs/bone_lengths"
        },
        "flips_repaired_total": {
          "type": "object",
          "properties": {
            "body": {
              "type": "integer",
              "minimum": 0
            },
            "legs": {
              "type": "integer",
              "minimum": 0
            },
            "arms": {
              "type": "integer",
              "minimum": 0
            },
            "face": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "body",
            "legs",
            "arms",
            "face"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "rule",
        "candidates",
        "frames_present",
        "frames_dropped",
        "few_frames",
        "measured_bone_lengths_m",
        "flips_repaired_total"
      ]
    },
    "coordinate_frame": {
      "type": "object",
      "properties": {
        "origin": {
          "const": "hip_midpoint"
        },
        "x": {
          "const": "subject_left"
        },
        "y": {
          "const": "world_up"
        },
        "z": {
          "const": "anterior"
        },
        "position_unit": {
          "const": "metres"
        },
        "angle_unit": {
          "const": "degrees"
        }
      },
      "required": [
        "origin",
        "x",
        "y",
        "z",
        "position_unit",
        "angle_unit"
      ],
      "description": "The frame Part 4 and Part 5 read. y is world_up: Part 3's body up is its estimate of world up."
    }
