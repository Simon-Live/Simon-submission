              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "frames",
            "weight"
          ],
          "description": "Only on resampled output: the two input frames the frame blends and the share of the second."
        }
      },
      "required": [
        "frame",
        "t_ms",
        "people"
      ]
    },
    "person": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/person_id"
