{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moalborati/simon-part-5-fault-analysis/contracts/labels.schema.json",
  "title": "Part 5 labels.json (evaluation labels)",
  "version": "1.0.0",
  "description": "Labelled follower takes for make check-5 and the real-take report: synthetic sets (simon.part5.labels.v1) and real takes (label_source visual). Extra fields are allowed.",
  "type": "object",
  "required": [
    "format",
    "takes"
  ],
  "properties": {
    "format": {
      "const": "simon.part5.labels.v1"
    },
    "generator": {
      "type": "string"
    },
    "seed": {
      "type": "integer",
      "description": "Generator seed of the set."
    },
    "label_source": {
      "enum": [
        "synthetic",
        "visual"
      ]
    },
    "labeller": {
      "type": "string"
    },
    "angles": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "lighting": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "takes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/take"
      }
    }
  },
  "$defs": {
    "take": {
      "type": "object",
      "required": [
        "take_id",
        "correct",
        "faults"
      ],
      "properties": {
        "take_id": {
          "type": "string",
          "minLength": 1
        },
        "set": {
          "type": "string"
        },
        "movement": {
          "type": [
            "string",
            "null"
          ]
        },
        "angle": {
          "enum": [
            "front",
            "45",
            "side"
          ]
        },
        "camera_yaw_deg": {
          "type": "number"
        },
        "lighting": {
          "enum": [
            "good",
            "low"
          ]
        },
        "variant": {
          "enum": [
            "clean",
            "dropout"
          ]
        },
        "label_source": {
          "enum": [
            "synthetic",
            "visual"
          ]
        },
        "labeller": {
          "type": "string"
        },
        "seed": {
          "type": "integer"
        },
        "correct": {
          "type": "boolean"
        },
        "body_scale": {
          "type": "number"
        },
        "speed": {
          "type": "number"
        },
        "lead_in_frames": {
          "type": "integer",
          "minimum": 0
        },
        "frame_count": {
          "type": "integer",
          "minimum": 1
        },
        "expected": {
          "type": "string"
        },
        "follower": {
          "type": "string"
        },
        "faults": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fault"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "correct": {
                "const": true
              }
            },
            "required": [
              "correct"
            ]
          },
          "then": {
            "properties": {
              "faults": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "correct": {
                "const": false
              }
            },
            "required": [
              "correct"
            ]
          },
          "then": {
            "properties": {
              "faults": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "fault": {
      "type": "object",
      "required": [
        "type",
        "measure",
        "body_part",
        "side",
        "direction"
      ],
      "properties": {
        "type": {
          "enum": [
            "arms_wider",
            "foot_out",
            "knees_shallow",
            "elbow_bent",
            "trunk_lean",
            "knee_caving"
          ]
        },
        "measure": {
          "type": "string",
          "minLength": 1
        },
        "body_part": {
          "enum": [
            "arms",
            "legs",
            "torso",
            "head"
          ]
        },
        "joints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "nose",
              "left_eye",
              "right_eye",
              "left_ear",
              "right_ear",
              "left_shoulder",
              "right_shoulder",
              "left_elbow",
              "right_elbow",
              "left_wrist",
              "right_wrist",
              "left_hip",
              "right_hip",
              "left_knee",
              "right_knee",
              "left_ankle",
              "right_ankle",
              "shoulder",
              "elbow",
              "wrist",
              "hip",
              "knee",
              "ankle",
              "spine",
              "shoulders",
              "neck"
            ]
          },
          "description": "Joints the label names: canonical, or spine for a trunk fault."
        },
        "side": {
          "enum": [
            "left",
            "right",
            "both",
            "center"
          ]
        },
        "direction": {
          "enum": [
            "more",
            "less"
          ]
        },
        "magnitude_deg": {
          "type": "number"
        },
        "peak_deg": {
          "type": "number"
        },
        "text": {
          "type": "string"
        },
        "follower_frames": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "expected_frames": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      }
    }
  }
}
