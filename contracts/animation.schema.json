{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moalborati/simon-part-4-animate-keyframes/contracts/animation.schema.json",
  "title": "animation.json written by Part 4",
  "description": "simon.animation.v1 exactly as Part 4 writes it: one frame per 30 fps tick, joints in metres in the hip-centred body frame. Every object is closed; a new field means a new format.",
  "x-simon-version": "simon.animation.v1",
  "x-direction": "output",
  "x-producer": "Part 4",
  "x-consumers": [
    "Part 5",
    "Part 6"
  ],
  "x-version-field": "format",
  "x-rules": [
    "frame_count equals round(duration_s * 30) + 1 and equals len(frames)",
    "frames[i].index equals i and frames[i].t equals index / 30",
    "interpolated is false exactly on the key indices of keyframes.json",
    "every bone in bones keeps length_m within 1 mm on every frame",
    "the hip midpoint stays within 1 mm of the origin"
  ],
  "$defs": {
    "vec3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "fps",
    "duration_s",
    "frame_count",
    "movement",
    "set",
    "coordinate_frame",
    "joints",
    "bones",
    "frames"
  ],
  "properties": {
    "format": {
      "const": "simon.animation.v1"
    },
    "fps": {
      "const": 30
    },
    "duration_s": {
      "type": "number",
      "minimum": 0
    },
    "frame_count": {
      "type": "integer",
      "minimum": 1
    },
    "movement": {
      "type": [
        "string",
        "null"
      ],
      "description": "From keyframes.json, else skeleton.json; null when neither names it."
    },
    "set": {
      "type": [
        "string",
        "null"
      ],
      "description": "From keyframes.json, else skeleton.json, else the --set name."
    },
    "coordinate_frame": {
      "const": {
        "origin": "hip_midpoint",
        "x": "subject_left",
        "y": "world_up",
        "z": "anterior",
        "position_unit": "metres",
        "angle_unit": "degrees",
        "notes": "z = x cross y. Hip midpoint is subtracted per frame."
      }
    },
    "joints": {
      "const": [
        "nose",
        "left_eye",
        "right_eye",
        "left_ear",
        "right_ear",
        "left_shoulder",
        "right_shoulder",
        "left_elbow",
        "right_elbow",
        "left_wrist",
        "right_wrist",
        "left_hip",
        "right_hip",
        "left_knee",
        "right_knee",
        "left_ankle",
        "right_ankle"
      ]
    },
    "bones": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "parent",
          "child",
          "length_m"
        ],
        "properties": {
          "name": {
            "enum": [
              "pelvis",
              "spine",
              "shoulder_girdle",
              "left_thigh",
              "left_shank",
              "right_thigh",
              "right_shank",
              "left_upper_arm",
              "left_forearm",
              "right_upper_arm",
              "right_forearm",
              "left_eye_link",
              "right_eye_link",
              "left_ear_link",
              "right_ear_link"
            ]
          },
          "parent": {
            "type": "string"
          },
          "child": {
            "type": "string"
          },
          "length_m": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "t",
          "interpolated",
          "joints"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "t": {
            "type": "number",
            "minimum": 0,
            "description": "Seconds, index / 30."
          },
          "interpolated": {
            "type": "boolean",
            "description": "false on a key frame, true on every other frame."
          },
          "joints": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "nose",
              "left_eye",
              "right_eye",
              "left_ear",
              "right_ear",
              "left_shoulder",
              "right_shoulder",
              "left_elbow",
              "right_elbow",
              "left_wrist",
              "right_wrist",
              "left_hip",
              "right_hip",
              "left_knee",
              "right_knee",
              "left_ankle",
              "right_ankle"
            ],
            "properties": {
              "nose": {
                "$ref": "#/$defs/vec3"
              },
              "left_eye": {
                "$ref": "#/$defs/vec3"
              },
              "right_eye": {
                "$ref": "#/$defs/vec3"
              },
              "left_ear": {
                "$ref": "#/$defs/vec3"
              },
              "right_ear": {
                "$ref": "#/$defs/vec3"
              },
              "left_shoulder": {
                "$ref": "#/$defs/vec3"
              },
              "right_shoulder": {
                "$ref": "#/$defs/vec3"
              },
              "left_elbow": {
                "$ref": "#/$defs/vec3"
              },
              "right_elbow": {
                "$ref": "#/$defs/vec3"
              },
              "left_wrist": {
                "$ref": "#/$defs/vec3"
              },
              "right_wrist": {
                "$ref": "#/$defs/vec3"
              },
              "left_hip": {
                "$ref": "#/$defs/vec3"
              },
              "right_hip": {
                "$ref": "#/$defs/vec3"
              },
              "left_knee": {
                "$ref": "#/$defs/vec3"
              },
              "right_knee": {
                "$ref": "#/$defs/vec3"
              },
              "left_ankle": {
                "$ref": "#/$defs/vec3"
              },
              "right_ankle": {
                "$ref": "#/$defs/vec3"
              }
            }
          }
        }
      }
    }
  }
}
