{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moalborati/simon-part-5-fault-analysis/contracts/analysis.schema.json",
  "title": "Part 5 analysis.json (simon.analysis.v1)",
  "version": "1.1.0",
  "description": "Part 5's output for Part 7. The fields of 1.0 plus the optional additions of 1.1.0 (schema_version, status, phrasing, faults[].joints, runs, coaching, diagnostics.guard). A 1.0 document validates. Read status before faults: a refused take has status.code different_movement and faults []. Extra fields are allowed.",
  "type": "object",
  "required": [
    "format",
    "expected",
    "follower",
    "faults"
  ],
  "properties": {
    "format": {
      "const": "simon.analysis.v1"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "expected": {
      "$ref": "#/$defs/clip_ref"
    },
    "follower": {
      "$ref": "#/$defs/clip_ref"
    },
    "status": {
      "type": "object",
      "required": [
        "code",
        "text"
      ],
      "properties": {
        "code": {
          "enum": [
            "ok",
            "different_movement"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "faults": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fault"
      },
      "description": "Sorted by absolute magnitude, largest first. Empty for a correct take and for a refusal."
    },
    "phrasing": {
      "type": "object",
      "properties": {
        "requested": {
          "enum": [
            "template",
            "local-llm",
            "muse-spark"
          ]
        },
        "backend": {
          "enum": [
            "template",
            "local-llm",
            "muse-spark"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "fallback_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "faults": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "backend": {
                "enum": [
                  "template",
                  "local-llm",
                  "muse-spark"
                ]
              },
              "fallback_reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "properties": {
        "alignment_residual": {
          "type": "number"
        },
        "alignment_measures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "follower_span": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "guard": {
          "type": "object",
          "properties": {
            "residual": {
              "type": "number"
            },
            "timing_corr": {
              "type": "number"
            },
            "span_share": {
              "type": "number"
            },
            "limits": {
              "type": "object"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "properties": {
              "code": {
                "const": "different_movement"
              }
            },
            "required": [
              "code"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "faults": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "clip_ref": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fault": {
      "type": "object",
      "required": [
        "measure",
        "measure_kind",
        "joint",
        "body_part",
        "side",
        "direction",
        "magnitude_deg",
        "peak_deg",
        "threshold_deg",
        "unit",
        "expected_frames",
        "follower_frames",
        "phase",
        "coverage",
        "confidence",
        "text"
      ],
      "properties": {
        "measure": {
          "enum": [
            "elbow_flexion",
            "knee_flexion",
            "upper_arm_out",
            "upper_arm_forward",
            "forearm_out",
            "thigh_out",
            "thigh_forward",
            "foot_out",
            "trunk_lean_forward",
            "trunk_lean_side",
            "shoulder_tilt",
            "head_forward",
            "knee_valgus"
          ],
          "description": "What differed, side-less (upper_arm_out, knee_flexion, ...)."
        },
        "measure_kind": {
          "enum": [
            "angle",
            "direction"
          ]
        },
        "joint": {
          "enum": [
            "nose",
            "left_eye",
            "right_eye",
            "left_ear",
            "right_ear",
            "left_shoulder",
            "right_shoulder",
            "left_elbow",
            "right_elbow",
            "left_wrist",
            "right_wrist",
            "left_hip",
            "right_hip",
            "left_knee",
            "right_knee",
            "left_ankle",
            "right_ankle",
            "shoulder",
            "elbow",
            "wrist",
            "hip",
            "knee",
            "ankle",
            "spine",
            "shoulders",
            "neck"
          ],
          "description": "Where it differed. A sided joint, a side-stripped joint for side both, or spine, shoulders or neck for centre measures."
        },
        "body_part": {
          "enum": [
            "arms",
            "legs",
            "torso",
            "head"
          ]
        },
        "side": {
          "enum": [
            "left",
            "right",
            "both",
            "center"
          ],
          "description": "The subject's own sides."
        },
        "direction": {
          "enum": [
            "more",
            "less"
          ],
          "description": "More or less than the example."
        },
        "magnitude_deg": {
          "type": "number",
          "description": "Signed size, follower minus expected."
        },
        "peak_deg": {
          "type": "number"
        },
        "threshold_deg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "const": "degrees"
        },
        "expected_frames": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "follower_frames": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "phase": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "The plain-words line, lowercase fragment."
        },
        "joints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "nose",
              "left_eye",
              "right_eye",
              "left_ear",
              "right_ear",
              "left_shoulder",
              "right_shoulder",
              "left_elbow",
              "right_elbow",
              "left_wrist",
              "right_wrist",
              "left_hip",
              "right_hip",
              "left_knee",
              "right_knee",
              "left_ankle",
              "right_ankle"
            ]
          },
          "description": "Canonical joints to highlight. Optional (schema 1.1.0)."
        },
        "runs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "description": "Every counted run, in expected frames. Optional (schema 1.1.0)."
        },
        "coaching": {
          "type": "string",
          "description": "The phrasing backend's line. Optional (schema 1.1.0)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "measure": {
                "const": "elbow_flexion"
              }
            },
            "required": [
              "measure"
            ]
          },
          "then": {
            "properties": {
              "measure_kind": {
                "const": "angle"
              },
              "body_part": {
                "const": "arms"
              },
              "side": {
                "enum": [
                  "left",
                  "right",
                  "both"
                ]
              },
              "joint": {
                "enum": [
                  "left_elbow",
                  "right_elbow",
                  "elbow"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "measure": {
                "const": "knee_flexion"
              }
            },
            "required": [
              "measure"
            ]
          },
          "then": {
            "properties": {
              "measure_kind": {
                "const": "angle"
              },
              "body_part": {
                "const": "legs"
              },
              "side": {
                "enum": [
                  "left",
                  "right",
                  "both"
                ]
              },
              "joint": {
                "enum": [
                  "left_knee",
                  "right_knee",
                  "knee"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "measure": {
                "const": "upper_arm_out"
              }
            },
            "required": [
              "measure"
            ]
          },
          "then": {
            "properties": {
              "measure_kind": {
                "const": "direction"
              },
              "body_part": {
                "const": "arms"
              },
              "side": {
                "enum": [
                  "left",
                  "right",
                  "both"
                ]
              },
              "joint": {
                "enum": [
                  "left_shoulder",
                  "right_shoulder",
                  "shoulder"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "measure": {
                "const": "upper_arm_forward"
              }
            },
            "required": [
              "measure"
            ]
          },
          "then": {
            "properties": {
              "measure_kind": {
                "const": "direction"
              },
              "body_part": {
                "const": "arms"
              },
              "side": {
                "enum": [
                  "left",
                  "right",
                  "both"
                ]
              },
              "joint": {
                "enum": [
                  "left_shoulder",
                  "right_shoulder",
                  "shoulder"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "measure": {
                "const": "forearm_out"
              }
            },
            "required": [
              "measure"
            ]
          },
          "then": {
            "properties": {
              "measure_kind": {
                "const": "direction"
              },
              "body_part": {
                "const": "arms"
              },
              "side": {
                "enum": [
                  "left",
                  "right",
                  "both"
                ]
              },
              "joint": {
                "enum": [
                  "left_elbow",
                  "right_elbow",
                  "elbow"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "measure": {
                "const": "thigh_out"
              }
            },
            "required": [
              "measure"
            ]
          },
          "then": {
            "properties": {
              "measure_kind": {
                "const": "direction"
              },
              "body_part": {
                "const": "legs"
              },
              "side": {
                "enum": [
                  "left",
                  "right",
                  "both"
                ]
              },
              "joint": {
                "enum": [
                  "left_hip",
                  "right_hip",
                  "hip"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "measure": {
                "const": "thigh_forward"
              }
            },
            "required": [
              "measure"
            ]
          },
          "then": {
            "properties": {
              "measure_kind": {
                "const": "direction"
              },
              "body_part": {
                "const": "legs"
              },
              "side": {
                "enum": [
                  "left",
                  "right",
                  "both"
                ]
              },
              "joint": {
                "enum": [
                  "left_hip",
                  "right_hip",
                  "hip"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "measure": {
                "const": "foot_out"
              }
            },
            "required": [
              "measure"
            ]
          },
          "then": {
            "properties": {
              "measure_kind": {
                "const": "direction"
              },
              "body_part": {
                "const": "legs"
              },
              "side": {
                "enum": [
                  "left",
                  "right",
                  "both"
                ]
              },
              "joint": {
                "enum": [
                  "left_ankle",
                  "right_ankle",
                  "ankle"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "measure": {
                "const": "trunk_lean_forward"
              }
            },
            "required": [
              "measure"
            ]
          },
          "then": {
            "properties": {
              "measure_kind": {
                "const": "direction"
              },
              "body_part": {
                "const": "torso"
              },
              "side": {
                "const": "center"
              },
              "joint": {
                "const": "spine"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "measure": {
                "const": "trunk_lean_side"
              }
            },
            "required": [
              "measure"
            ]
          },
          "then": {
            "properties": {
              "measure_kind": {
                "const": "direction"
              },
              "body_part": {
                "const": "torso"
              },
              "side": {
                "const": "center"
              },
              "joint": {
                "const": "spine"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "measure": {
                "const": "shoulder_tilt"
              }
            },
            "required": [
              "measure"
            ]
          },
          "then": {
            "properties": {
              "measure_kind": {
                "const": "direction"
              },
              "body_part": {
                "const": "torso"
              },
              "side": {
                "const": "center"
              },
              "joint": {
                "const": "shoulders"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "measure": {
                "const": "head_forward"
              }
            },
            "required": [
              "measure"
            ]
          },
          "then": {
            "properties": {
              "measure_kind": {
                "const": "direction"
              },
              "body_part": {
                "const": "head"
              },
              "side": {
                "const": "center"
              },
              "joint": {
                "const": "neck"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "measure": {
                "const": "knee_valgus"
              }
            },
            "required": [
              "measure"
            ]
          },
          "then": {
            "properties": {
              "measure_kind": {
                "enum": [
                  "angle",
                  "direction"
                ]
              },
              "body_part": {
                "const": "legs"
              },
              "side": {
                "enum": [
                  "left",
                  "right",
                  "both"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "side": {
                "const": "left"
              }
            },
            "required": [
              "side"
            ]
          },
          "then": {
            "properties": {
              "joint": {
                "pattern": "^left_"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "side": {
                "const": "right"
              }
            },
            "required": [
              "side"
            ]
          },
          "then": {
            "properties": {
              "joint": {
                "pattern": "^right_"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "side": {
                "const": "both"
              }
            },
            "required": [
              "side"
            ]
          },
          "then": {
            "properties": {
              "joint": {
                "pattern": "^[a-z]+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "direction": {
                "const": "more"
              }
            },
            "required": [
              "direction"
            ]
          },
          "then": {
            "properties": {
              "magnitude_deg": {
                "exclusiveMinimum": 0
              },
              "peak_deg": {
                "exclusiveMinimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "direction": {
                "const": "less"
              }
            },
            "required": [
              "direction"
            ]
          },
          "then": {
            "properties": {
              "magnitude_deg": {
                "exclusiveMaximum": 0
              },
              "peak_deg": {
                "exclusiveMaximum": 0
              }
            }
          }
        }
      ]
    }
  }
}
