{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moalborati/simon-part-5-fault-analysis/contracts/analysis.schema.json",
  "title": "Part 5 analysis.json (simon.analysis.v1)",
  "version": "1.4.0",
  "description": "Part 5's output for Part 7. The fields of 1.0 plus the optional additions of 1.1.0 and 1.2.0 (schema_version, status, phrasing, faults[].joints, runs, coaching, diagnostics.guard; 1.2.0: faults[].follower_t_s, at_s, follower_runs, lateral, lateral_m, text_timed and the top-level score; 1.3.0: faults[].reps, diagnostics.guard.reps, diagnostics.expected_reference and score.per_rep, for a take compared one repetition at a time). A document without them keeps schema_version 1.2.0. A 1.0 document validates. Read status before faults: a refused take has status.code different_movement and faults []. Extra fields are allowed. 1.4.0 (ADR-0012): a take is always analysed. status.code is ok for every analysis; what used to be a refusal is an entry in the top-level warnings ([{code, text}]: low_match, moving_part_out_of_frame, not_enough_visible, no_usable_measures), with match ({quality ok|low, residual, timing_corr, limits}); on a low match each fault has confidence \"low\"; score is never null, is capped at 59 (grade F) when any warning is present, and then names the codes in score.capped_by. A document without warnings keeps its earlier schema_version.",
  "type": "object",
  "required": [
    "format",
    "expected",
    "follower",
    "faults"
  ],
  "properties": {
    "format": {
      "const": "simon.analysis.v1"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "expected": {
      "$ref": "#/$defs/clip_ref"
    },
    "follower": {
      "$ref": "#/$defs/clip_ref"
    },
    "status": {
      "type": "object",
      "required": [
        "code",
        "text"
      ],
      "properties": {
        "code": {
          "enum": [
            "ok",
            "different_movement",
            "not_enough_visible",
            "moving_part_out_of_frame"
          ],
          "description": "ok for every analysis from 1.4.0; the other values only in documents written before ADR-0012."
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "faults": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fault"
      },
      "description": "Sorted by absolute magnitude, largest first. Empty for a correct take, for a refusal in a document before 1.4.0, and when nothing was detected."
    },
    "phrasing": {
      "type": "object",
      "properties": {
        "requested": {
          "enum": [
            "template",
            "local-llm",
            "muse-spark"
          ]
        },
        "backend": {
          "enum": [
            "template",
            "local-llm",
            "muse-spark"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "fallback_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "faults": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "backend": {
                "enum": [
                  "template",
                  "local-llm",
                  "muse-spark"
                ]
              },
              "fallback_reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "properties": {
        "alignment_residual": {
          "type": "number"
        },
        "alignment_measures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "follower_span": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "guard": {
          "type": "object",
          "properties": {
            "residual": {
              "type": "number"
            },
            "timing_corr": {
              "type": "number"
            },
            "span_share": {
              "type": "number"
            },
            "limits": {
              "type": "object"
            },
            "reps": {
              "type": "array",
              "description": "1.3.0: one entry per follower repetition: its start and end on the follower file's clock, the guard's numbers for it (null when it could not be aligned) and whether it passed.",
              "items": {
                "type": "object",
                "required": [
                  "span_s",
                  "ok"
                ],
                "properties": {
                  "span_s": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "number"
                    }
                  },
                  "residual": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "timing_corr": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "ok": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "expected_reference": {
          "type": "object",
          "description": "1.3.0: which part of the expected clip the follower repetitions were compared with: kind first_rep (its first complete repetition) or whole (it holds one).",
          "required": [
            "kind",
            "frames"
          ],
          "properties": {
            "kind": {
              "enum": [
                "first_rep",
                "whole"
              ]
            },
            "frames": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "span_s": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            },
            "expected_reps": {
              "type": "integer",
              "minimum": 1
            },
            "follower_reps": {
              "type": "integer",
              "minimum": 1
            },
            "measure": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "visibility": {
          "type": "object",
          "description": "1.3.0: present when the take was compared on fewer measures than the full body because the camera did not see the rest (ADR-0011): usable_measures (how many), excluded (the measures left out) and rule (the sentence that decided).",
          "required": [
            "usable_measures",
            "excluded"
          ],
          "properties": {
            "usable_measures": {
              "type": "integer",
              "minimum": 0
            },
            "excluded": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rule": {
              "type": "string"
            },
            "moving_measures": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Measures that move in the expected clip (robust range above 20 degrees) among those the example shows."
            },
            "moving_usable": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Those of moving_measures the take also shows; none of them means status moving_part_out_of_frame."
            }
          }
        }
      }
    },
    "score": {
      "type": [
        "object",
        "null"
      ],
      "description": "simon.score.v1. Never null from 1.4.0 (0, grade F when nothing could be measured); capped at 59 with capped_by when the document has warnings. null only in a refused document of 1.3.0 or earlier. Absent when the producer does not score.",
      "properties": {
        "version": {
          "const": "simon.score.v1"
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "grade": {
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "F"
          ]
        },
        "components": {
          "type": "object",
          "properties": {
            "faults": {
              "type": "number"
            },
            "similarity": {
              "type": "number"
            }
          }
        },
        "params_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "per_rep": {
          "type": "array",
          "description": "1.3.0: the value and grade of each accepted repetition; the score is their mean (components are the means).",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "grade": {
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D",
                  "F"
                ]
              }
            }
          }
        },
        "capped_by": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "1.4.0: the warning codes that capped the value at 59."
        }
      }
    },
    "warnings": {
      "type": "array",
      "minItems": 1,
      "description": "1.4.0: why the grade is capped at F; present only when the take had a warning.",
      "items": {
        "type": "object",
        "required": [
          "code",
          "text"
        ],
        "properties": {
          "code": {
            "enum": [
              "low_match",
              "moving_part_out_of_frame",
              "not_enough_visible",
              "no_usable_measures"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "match": {
      "type": "object",
      "description": "1.4.0: how closely the take matches the trainer's movement; present with warnings. quality is low when the guard would have refused.",
      "required": [
        "quality",
        "limits"
      ],
      "properties": {
        "quality": {
          "enum": [
            "ok",
            "low"
          ]
        },
        "residual": {
          "type": [
            "number",
            "null"
          ]
        },
        "timing_corr": {
          "type": [
            "number",
            "null"
          ]
        },
        "limits": {
          "type": "object"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "properties": {
              "code": {
                "enum": [
                  "different_movement",
                  "not_enough_visible",
                  "moving_part_out_of_frame"
                ]
              }
            },
            "required": [
              "code"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "faults": {
            "maxItems": 0
          }
        },
        "$comment": "documents written before ADR-0012 (1.3.0 and earlier): a refusal has no faults"
      }
    }
  ],
  "$defs": {
    "clip_ref": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fault": {
      "type": "object",
      "required": [
        "measure",
        "measure_kind",
        "joint",
        "body_part",
        "side",
        "direction",
        "magnitude_deg",
        "peak_deg",
        "threshold_deg",
        "unit",
        "expected_frames",
        "follower_frames",
        "phase",
        "coverage",
        "confidence",
        "text"
      ],
      "properties": {
        "measure": {
          "enum": [
            "elbow_flexion",
            "knee_flexion",
            "upper_arm_out",
            "upper_arm_forward",
            "forearm_out",
            "thigh_out",
            "thigh_forward",
            "foot_out",
            "trunk_lean_forward",
            "trunk_lean_side",
            "shoulder_tilt",
            "head_forward",
            "knee_valgus"
          ],
          "description": "What differed, side-less (upper_arm_out, knee_flexion, ...)."
        },
        "measure_kind": {
          "enum": [
            "angle",
            "direction"
          ]
        },
        "joint": {
          "enum": [
            "nose",
            "left_eye",
            "right_eye",
            "left_ear",
            "right_ear",
            "left_shoulder",
            "right_shoulder",
            "left_elbow",
            "right_elbow",
            "left_wrist",
            "right_wrist",
            "left_hip",
            "right_hip",
            "left_knee",
            "right_knee",
            "left_ankle",
            "right_ankle",
            "shoulder",
            "elbow",
            "wrist",
            "hip",
            "knee",
            "ankle",
            "spine",
            "shoulders",
            "neck"
          ],
          "description": "Where it differed. A sided joint, a side-stripped joint for side both, or spine, shoulders or neck for centre measures."
        },
        "body_part": {
          "enum": [
            "arms",
            "legs",
            "torso",
            "head"
          ]
        },
        "side": {
          "enum": [
            "left",
            "right",
            "both",
            "center"
          ],
          "description": "The subject's own sides."
        },
        "direction": {
          "enum": [
            "more",
            "less"
          ],
          "description": "More or less than the example."
        },
        "magnitude_deg": {
          "type": "number",
          "description": "Signed size, follower minus expected."
        },
        "peak_deg": {
          "type": "number"
        },
        "threshold_deg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "const": "degrees"
        },
        "expected_frames": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "follower_frames": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "phase": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confidence": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "const": "low"
            }
          ],
          "description": "A number in 0..1, or \"low\" on a low match (1.4.0)."
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "The plain-words line, lowercase fragment."
        },
        "joints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "nose",
              "left_eye",
              "right_eye",
              "left_ear",
              "right_ear",
              "left_shoulder",
              "right_shoulder",
              "left_elbow",
              "right_elbow",
              "left_wrist",
              "right_wrist",
              "left_hip",
              "right_hip",
              "left_knee",
              "right_knee",
              "left_ankle",
              "right_ankle"
            ]
          },
          "description": "Canonical joints to highlight. Optional (schema 1.1.0)."
        },
        "runs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "description": "Every counted run, in expected frames. Optional (schema 1.1.0)."
        },
        "coaching": {
          "type": "string",
          "description": "The phrasing backend's line. Optional (schema 1.1.0)."
        },
        "follower_t_s": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "minItems": 2,
          "maxItems": 2,
          "description": "Seconds on the follower file's own clock at follower_frames[0] and [1]."
        },
        "at_s": {
          "type": "number",
          "description": "follower_t_s[0] rounded half up to 0.1 s."
        },
        "follower_runs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "description": "Every run in follower file frames, same order as runs."
        },
        "lateral": {
          "enum": [
            "left",
            "right",
            null
          ],
          "description": "Which way the part is off, in the subject's own frame (like side); null when no direction applies."
        },
        "lateral_m": {
          "type": "number",
          "description": "foot_out on one side only: metres further out (positive) than the example."
        },
        "text_timed": {
          "type": "string",
          "minLength": 1,
          "description": "The timed words plus ' at <at_s> s'."
        },
        "reps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "1.3.0: the follower repetitions (0-based, in order) this fault was found in; at_s, follower_t_s and follower_runs are those of the first."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "measure": {
                "const": "elbow_flexion"
              }
            },
            "required": [
              "measure"
            ]
          },
          "then": {
            "properties": {
              "measure_kind": {
                "const": "angle"
              },
              "body_part": {
                "const": "arms"
              },
              "side": {
                "enum": [
                  "left",
                  "right",
                  "both"
                ]
              },
              "joint": {
                "enum": [
                  "left_elbow",
                  "right_elbow",
                  "elbow"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "measure": {
                "const": "knee_flexion"
              }
            },
            "required": [
              "measure"
            ]
          },
          "then": {
            "properties": {
              "measure_kind": {
                "const": "angle"
              },
              "body_part": {
                "const": "legs"
              },
              "side": {
                "enum": [
                  "left",
                  "right",
                  "both"
                ]
              },
              "joint": {
                "enum": [
                  "left_knee",
                  "right_knee",
                  "knee"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "measure": {
                "const": "upper_arm_out"
              }
            },
            "required": [
              "measure"
            ]
          },
          "then": {
            "properties": {
              "measure_kind": {
                "const": "direction"
              },
              "body_part": {
                "const": "arms"
              },
              "side": {
                "enum": [
                  "left",
                  "right",
                  "both"
                ]
              },
              "joint": {
                "enum": [
                  "left_shoulder",
                  "right_shoulder",
                  "shoulder"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "measure": {
                "const": "upper_arm_forward"
              }
            },
            "required": [
              "measure"
            ]
          },
          "then": {
            "properties": {
              "measure_kind": {
                "const": "direction"
              },
              "body_part": {
                "const": "arms"
              },
              "side": {
                "enum": [
                  "left",
                  "right",
                  "both"
                ]
              },
              "joint": {
                "enum": [
                  "left_shoulder",
                  "right_shoulder",
                  "shoulder"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "measure": {
                "const": "forearm_out"
              }
            },
            "required": [
              "measure"
            ]
          },
          "then": {
            "properties": {
              "measure_kind": {
                "const": "direction"
              },
              "body_part": {
                "const": "arms"
              },
              "side": {
                "enum": [
                  "left",
                  "right",
                  "both"
                ]
              },
              "joint": {
                "enum": [
                  "left_elbow",
                  "right_elbow",
                  "elbow"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "measure": {
                "const": "thigh_out"
              }
            },
            "required": [
              "measure"
            ]
          },
          "then": {
            "properties": {
              "measure_kind": {
                "const": "direction"
              },
              "body_part": {
                "const": "legs"
              },
              "side": {
                "enum": [
                  "left",
                  "right",
                  "both"
                ]
              },
              "joint": {
                "enum": [
                  "left_hip",
                  "right_hip",
                  "hip"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "measure": {
                "const": "thigh_forward"
              }
            },
            "required": [
              "measure"
            ]
          },
          "then": {
            "properties": {
              "measure_kind": {
                "const": "direction"
              },
              "body_part": {
                "const": "legs"
              },
              "side": {
                "enum": [
                  "left",
                  "right",
                  "both"
                ]
              },
              "joint": {
                "enum": [
                  "left_hip",
                  "right_hip",
                  "hip"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "measure": {
                "const": "foot_out"
              }
            },
            "required": [
              "measure"
            ]
          },
          "then": {
            "properties": {
              "measure_kind": {
                "const": "direction"
              },
              "body_part": {
                "const": "legs"
              },
              "side": {
                "enum": [
                  "left",
                  "right",
                  "both"
                ]
              },
              "joint": {
                "enum": [
                  "left_ankle",
                  "right_ankle",
                  "ankle"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "measure": {
                "const": "trunk_lean_forward"
              }
            },
            "required": [
              "measure"
            ]
          },
          "then": {
            "properties": {
              "measure_kind": {
                "const": "direction"
