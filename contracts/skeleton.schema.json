{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moalborati/simon-part-3-skeleton-consistency/contracts/skeleton.schema.json",
  "title": "Part 3 skeleton.json (native)",
  "description": "The native output of python3 -m part3 run. One person, one fixed set of bone lengths, hip-centred, body-up. frames keeps the pose3d.json shape, so a skeleton.json is also a valid pose3d.json. The body block, input.adapters, person.requested, resample and the per-frame source appear in newer files and are optional here so older files validate too. Part 3's own validator (python3 -m part3.schema) checks what a schema cannot: rounding, bone lengths against the profile, frame counts.",
  "x-simon-version": "simon.skeleton/1",
  "x-direction": "output",
  "x-producer": "Part 3",
  "x-consumers": [
    "Part 3 (as pose3d input)",
    "Part 7"
  ],
  "x-version-field": "schema",
  "type": "object",
  "required": [
    "schema",
    "units",
    "frame",
    "joints",
    "bones",
    "standard",
    "bone_lengths_m",
    "person",
    "mirror",
    "input",
    "frames"
  ],
  "properties": {
    "schema": {
      "const": "simon.skeleton/1"
    },
    "units": {
      "const": {
        "length": "m",
        "angle": "deg",
        "time": "ms"
      }
    },
    "frame": {
      "type": "object",
      "properties": {
        "origin": {
          "const": "hip_midpoint"
        },
        "x": {
          "const": "subject_left"
        },
        "y": {
          "const": "body_up"
        },
        "z": {
          "const": "anterior"
        },
        "up_source": {
          "enum": [
            "standing_frames",
            "input_up",
            "all_frames"
          ]
        }
      },
      "required": [
        "origin",
        "x",
        "y",
        "z",
        "up_source"
      ]
    },
    "joints": {
      "const": [
        "nose",
        "left_eye",
        "right_eye",
        "left_ear",
        "right_ear",
        "left_shoulder",
        "right_shoulder",
        "left_elbow",
        "right_elbow",
        "left_wrist",
        "right_wrist",
        "left_hip",
        "right_hip",
        "left_knee",
        "right_knee",
        "left_ankle",
        "right_ankle"
      ]
    },
    "bones": {
      "const": [
        {
          "name": "left_pelvis",
          "from": "root",
          "to": "left_hip"
        },
        {
          "name": "right_pelvis",
          "from": "root",
          "to": "right_hip"
        },
        {
          "name": "left_thigh",
          "from": "left_hip",
          "to": "left_knee"
        },
        {
          "name": "right_thigh",
          "from": "right_hip",
          "to": "right_knee"
        },
        {
          "name": "left_shank",
          "from": "left_knee",
          "to": "left_ankle"
        },
        {
          "name": "right_shank",
          "from": "right_knee",
          "to": "right_ankle"
        },
        {
          "name": "spine",
          "from": "root",
          "to": "neck"
        },
        {
          "name": "left_clavicle",
          "from": "neck",
          "to": "left_shoulder"
        },
        {
          "name": "right_clavicle",
          "from": "neck",
          "to": "right_shoulder"
        },
        {
          "name": "left_upper_arm",
          "from": "left_shoulder",
          "to": "left_elbow"
        },
        {
          "name": "right_upper_arm",
          "from": "right_shoulder",
          "to": "right_elbow"
        },
        {
          "name": "left_forearm",
          "from": "left_elbow",
          "to": "left_wrist"
        },
        {
          "name": "right_forearm",
          "from": "right_elbow",
          "to": "right_wrist"
        },
        {
          "name": "head",
          "from": "neck",
          "to": "nose"
        },
        {
          "name": "left_eye_link",
          "from": "nose",
          "to": "left_eye"
        },
        {
          "name": "right_eye_link",
          "from": "nose",
          "to": "right_eye"
        },
        {
          "name": "left_ear_link",
          "from": "left_eye",
          "to": "left_ear"
        },
        {
          "name": "right_ear_link",
          "from": "right_eye",
          "to": "right_ear"
        }
      ]
    },
    "standard": {
      "type": "object",
      "properties": {
        "stature_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "required": [
        "stature_m",
        "sources"
      ]
    },
    "bone_lengths_m": {
      "$ref": "#/$defs/bone_lengths"
    },
    "body": {
      "$ref": "#/$defs/body"
    },
    "person": {
      "$ref": "#/$defs/person"
    },
    "mirror": {
      "type": "object",
      "properties": {
        "setting": {
          "enum": [
            "auto",
            "on",
            "off"
          ]
        },
        "applied": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "setting",
        "applied",
        "reason"
      ]
    },
    "input": {
      "type": "object",
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "adapters": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Names of the input adapters that fired, in order."
        }
      },
      "required": [
        "sha256"
      ]
    },
    "resample": {
      "type": "object",
      "properties": {
        "fps": {
          "type": "number",
          "minimum": 1,
          "maximum": 240
        },
        "source_frames": {
          "type": "integer",
          "minimum": 1
        },
        "method": {
          "type": "string"
        }
      },
      "required": [
        "fps",
        "source_frames",
        "method"
      ],
      "description": "Only with --fps."
    },
    "frames": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/frame"
      }
    }
  },
  "$defs": {
    "person_id": {
      "type": [
        "integer",
        "string"
      ],
      "description": "A person id as Part 2 writes it: an integer or a string."
    },
    "joint": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "conf": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "x",
        "y",
        "z",
        "conf"
      ],
      "description": "One joint: metres and a confidence in 0 to 1."
    },
    "joints": {
      "type": "object",
      "properties": {
        "nose": {
          "$ref": "#/$defs/joint"
        },
        "left_eye": {
          "$ref": "#/$defs/joint"
        },
        "right_eye": {
          "$ref": "#/$defs/joint"
        },
        "left_ear": {
          "$ref": "#/$defs/joint"
        },
        "right_ear": {
          "$ref": "#/$defs/joint"
        },
        "left_shoulder": {
          "$ref": "#/$defs/joint"
        },
        "right_shoulder": {
          "$ref": "#/$defs/joint"
        },
        "left_elbow": {
          "$ref": "#/$defs/joint"
        },
        "right_elbow": {
          "$ref": "#/$defs/joint"
        },
        "left_wrist": {
          "$ref": "#/$defs/joint"
        },
        "right_wrist": {
          "$ref": "#/$defs/joint"
        },
        "left_hip": {
          "$ref": "#/$defs/joint"
        },
        "right_hip": {
          "$ref": "#/$defs/joint"
        },
        "left_knee": {
          "$ref": "#/$defs/joint"
        },
        "right_knee": {
          "$ref": "#/$defs/joint"
        },
        "left_ankle": {
          "$ref": "#/$defs/joint"
        },
        "right_ankle": {
          "$ref": "#/$defs/joint"
        }
      },
      "required": [
        "nose",
        "left_eye",
        "right_eye",
        "left_ear",
        "right_ear",
        "left_shoulder",
        "right_shoulder",
        "left_elbow",
        "right_elbow",
        "left_wrist",
        "right_wrist",
        "left_hip",
        "right_hip",
        "left_knee",
        "right_knee",
        "left_ankle",
        "right_ankle"
      ],
      "additionalProperties": false
    },
    "bone_lengths": {
      "type": "object",
      "properties": {
        "left_pelvis": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "right_pelvis": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "left_thigh": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "right_thigh": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "left_shank": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "right_shank": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "spine": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "left_clavicle": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "right_clavicle": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "left_upper_arm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "right_upper_arm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "left_forearm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "right_forearm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "head": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "left_eye_link": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "right_eye_link": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "left_ear_link": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "right_ear_link": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "left_pelvis",
        "right_pelvis",
        "left_thigh",
        "right_thigh",
        "left_shank",
        "right_shank",
        "spine",
        "left_clavicle",
        "right_clavicle",
        "left_upper_arm",
        "right_upper_arm",
        "left_forearm",
        "right_forearm",
        "head",
        "left_eye_link",
        "right_eye_link",
        "left_ear_link",
        "right_ear_link"
      ],
      "additionalProperties": false
    },
    "body": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1,
          "description": "simon-standard, part4-rig, measured, or file:<name from the profile file>."
        },
        "selected_by": {
          "enum": [
            "flag",
            "env",
            "config",
            "api",
            "default"
          ],
          "description": "Which channel chose the profile; default means none did, and the view's default was used (part4-rig for --view part4, simon-standard otherwise)."
        },
        "stature_selected_by": {
          "enum": [
            "flag",
            "env",
            "config",
            "api"
          ],
          "description": "Present when a stature was requested: which channel set it."
        },
        "stature_m": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2.5
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "symmetrized": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "Present only when the view chose the profile (selected_by default and --view part4): why that profile was used. A body named on any channel wins and has no reason."
        }
      },
      "required": [
        "profile",
        "selected_by",
        "stature_m",
        "scale",
        "source",
        "symmetrized"
      ],
      "description": "The body profile the output was rebuilt on."
    },
    "person_entry": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/person_id"
        },
        "joints": {
          "$ref": "#/$defs/joints"
        },
        "flips_repaired": {
          "type": "array",
          "items": {
            "enum": [
              "body",
              "legs",
              "arms",
              "face"
            ]
          }
        }
      },
      "required": [
        "id",
        "joints",
        "flips_repaired"
      ]
    },
    "frame": {
      "type": "object",
      "properties": {
        "frame": {
          "type": "integer"
        },
        "t_ms": {
          "type": "number"
        },
        "people": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/person_entry"
          },
          "maxItems": 1
        },
        "source": {
          "type": "object",
          "properties": {
            "frames": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "weight": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "frames",
            "weight"
          ],
          "description": "Only on resampled output: the two input frames the frame blends and the share of the second."
        }
      },
      "required": [
        "frame",
        "t_ms",
        "people"
      ]
    },
    "person": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/person_id"
        },
        "rule": {
          "enum": [
            "most_frames",
            "requested"
          ]
        },
        "requested": {
          "$ref": "#/$defs/person_id"
        },
        "candidates": {
          "type": "object",
          "properties": {},
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "frames_present": {
          "type": "integer",
          "minimum": 0
        },
        "frames_dropped": {
          "type": "integer",
          "minimum": 0
        },
        "few_frames": {
          "type": "boolean"
        },
        "measured_bone_lengths_m": {
          "$ref": "#/$defs/bone_lengths"
        },
        "flips_repaired_total": {
          "type": "object",
          "properties": {
            "body": {
              "type": "integer",
              "minimum": 0
            },
            "legs": {
              "type": "integer",
              "minimum": 0
            },
            "arms": {
              "type": "integer",
              "minimum": 0
            },
            "face": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "body",
            "legs",
            "arms",
            "face"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "rule",
        "candidates",
        "frames_present",
        "frames_dropped",
        "few_frames",
        "measured_bone_lengths_m",
        "flips_repaired_total"
      ]
    }
  }
}
