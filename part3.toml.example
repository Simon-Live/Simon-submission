# Copy this file to part3.toml (read from the working directory) or point PART3_CONFIG at it.
# Order of precedence, first set wins: --body / --stature, then PART3_BODY / PART3_STATURE, then
# this file, then the body= / stature= arguments of the Python API, then the defaults.
# --keyframes-densify, PART3_KEYFRAMES_DENSIFY and [keyframes] densify follow the same order.
[body]
# simon-standard (default), part4-rig, measured, or file:<path to a body profile JSON>.
# A relative file: path is relative to this file's folder.
profile = "simon-standard"
# Scale every bone length so the body has this stature in metres (0.5 to 2.5).
# stature = 1.80

[keyframes]
# every:<n> (n from 1 to 300) adds a key every n ticks between the keys of a --keyframes file
# (--view part4 only); off turns it off.
# densify = "every:10"
