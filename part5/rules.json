{
  "_comment": "Fault rules for part5.detect. Degrees and frames at the expected clip's rate. Tuned on the seed 5 tuning set only (docs/thresholds.md, ADR-0003).",
  "smooth_frames": 5,
  "tolerance_frames": 0,
  "default": {
    "threshold_deg": 10.0,
    "min_fraction": 0.38,
    "min_frames_floor": 32,
    "min_frames_floor_body": 8,
    "reference_fps": 30.0,
    "floor_share": 0.75,
    "min_run_frames": 4,
    "min_overlap": 0.3
  },
  "measures": {
    "elbow_flexion": {
      "threshold_deg": 20.0
    },
    "knee_flexion": {
      "threshold_deg": 10.0
    },
    "upper_arm_out": {
      "threshold_deg": 11.0
    },
    "forearm_out": {
      "threshold_deg": 17.0
    },
    "thigh_out": {
      "threshold_deg": 13.0
    },
    "foot_out": {
      "threshold_deg": 6.0
    },
    "knee_valgus": {
      "threshold_deg": 9.0
    },
    "upper_arm_forward": {
      "threshold_deg": 15.0
    },
    "thigh_forward": {
      "threshold_deg": 15.0
    },
    "trunk_lean_forward": {
      "threshold_deg": 9.0
    },
    "trunk_lean_side": {
      "threshold_deg": 9.0
    },
    "shoulder_tilt": {
      "threshold_deg": 9.0
    },
    "head_forward": {
      "threshold_deg": 18.0
    },
    "foot_rotation": {
      "threshold_deg": 14.0,
      "max_jitter_deg": 4.0
    },
    "ankle_inversion": {
      "threshold_deg": 14.0,
      "max_jitter_deg": 4.0
    }
  },
  "guard": {
    "_comment": "Movement guard (ADR-0004): refuse when residual > max_residual or timing_corr < min_timing_corr. Midpoints of the gap on seed 5 (python -m part5.calibrate --guard): matched pairs against mismatch pairs; docs/thresholds.md gives both populations.",
    "max_residual": 0.5677,
    "min_timing_corr": 0.8336
  },
  "explained_by": {
    "_comment": "A fault in the key measure is dropped when a kept fault in one of the listed measures, same side and same direction, overlaps it by min_overlap of the shorter one: the listed one is the cause, the key one follows from it.",
    "thigh_out": [
      "foot_out"
    ],
    "knee_flexion": [
      "knee_valgus"
    ],
    "forearm_out": [
      "upper_arm_out"
    ],
    "upper_arm_forward": [
      "trunk_lean_forward"
    ],
    "thigh_forward": [
      "trunk_lean_forward"
    ],
    "head_forward": [
      "trunk_lean_forward"
    ]
  },
  "explained_by_opposite": {
    "_comment": "Like explained_by, but the kept fault is in the other direction: a knee caving in (knee_valgus more) pulls the thigh in (thigh_out less).",
    "thigh_out": [
      "knee_valgus"
    ]
  },
  "score": {
    "version": "simon.score.v1",
    "z0": 0.289,
    "z1": 0.732,
    "s_max": 4.0,
    "base": 16,
    "slope": 5.9,
    "cap": 31.1,
    "bands": [
      [
        90,
        "A"
      ],
      [
        80,
        "B"
      ],
      [
        70,
        "C"
      ],
      [
        60,
        "D"
      ],
      [
        0,
        "F"
      ]
    ],
    "calibrated_on": "seed 5"
  }
}
