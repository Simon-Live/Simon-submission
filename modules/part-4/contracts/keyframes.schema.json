{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moalborati/simon-part-4-animate-keyframes/contracts/keyframes.schema.json",
  "title": "keyframes.json read by Part 4",
  "description": "The 30 fps timeline Part 4 animates: which frame indices are keys. Part 3 writes it with --view part4 --keyframes-out. Part 1's own keyframes.json (video clock, per person) is not this file; Part 3 maps it onto this timeline. Extra keys are allowed and ignored.",
  "x-simon-version": "simon.keyframes.v1",
  "x-direction": "input",
  "x-producer": "Part 3 (--keyframes-out) or a hand-authored fixture",
  "x-consumers": [
    "Part 4"
  ],
  "x-version-field": "format",
  "x-rules": [
    "frame_count equals round(duration_s * 30) + 1",
    "keyframes[].index strictly increases and lies in 0 .. frame_count - 1",
    "keyframes[].t equals index / 30 within one microsecond",
    "the key indices equal the keyframes[].index list of the skeleton.json beside this file"
  ],
  "type": "object",
  "required": [
    "format",
    "fps",
    "duration_s",
    "frame_count",
    "keyframes"
  ],
  "properties": {
    "format": {
      "const": "simon.keyframes.v1"
    },
    "fps": {
      "const": 30
    },
    "duration_s": {
      "type": "number",
      "minimum": 0
    },
    "frame_count": {
      "type": "integer",
      "minimum": 1
    },
    "set": {
      "type": "string"
    },
    "movement": {
      "type": "string"
    },
    "keyframes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "index",
          "t"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "t": {
            "type": "number",
            "minimum": 0,
            "description": "Seconds, index / 30."
          },
          "name": {
            "type": "string"
          }
        }
      }
    }
  }
}
